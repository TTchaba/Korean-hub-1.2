# ── Public site configuration ────────────────────────────────────────
# Full public URL of the deployed site (used for SEO metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase Web app configuration (Firebase console → Project settings → General → Your apps).
# These values are public; Firestore security rules protect the database.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=koreanhubgeorgia
NEXT_PUBLIC_FIREBASE_APP_ID=
